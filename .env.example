# Dialectica 配置样例。复制为 .env 后按需修改。
# 默认值（不设任何环境变量）= 离线零依赖模式：确定性 Mock LLM + 哈希嵌入 + 内存索引。
# 作者: 晨星

# ---- 模型后端 ----
# mock | llamacpp | ollama | openai
DIALECTICA_LLM_BACKEND=mock
DIALECTICA_LLM_MODEL=mock-1
# llamacpp 需要本地 GGUF
DIALECTICA_GGUF_PATH=
DIALECTICA_N_CTX=4096
# 小量化模型是内存带宽受限，线程过多反而更慢，锁在 2-4
DIALECTICA_N_THREADS=4
DIALECTICA_OLLAMA_HOST=http://127.0.0.1:11434
DIALECTICA_OPENAI_BASE_URL=
DIALECTICA_OPENAI_API_KEY=

# ---- 嵌入与向量 ----
# hashing（离线默认）| fastembed
DIALECTICA_EMBEDDING_BACKEND=hashing
DIALECTICA_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# memory（离线默认）| faiss
DIALECTICA_VECTOR_BACKEND=memory

# ---- 检索 ----
DIALECTICA_CHUNK_SIZE=480
DIALECTICA_CHUNK_OVERLAP=80
DIALECTICA_TOP_K=8
DIALECTICA_CANDIDATE_POOL=40
DIALECTICA_RRF_K=60
DIALECTICA_ADAPTIVE_FUSION=1

# ---- 重排护栏 ----
DIALECTICA_RERANK_ENABLED=1
# heuristic（离线默认）| cross-encoder
DIALECTICA_RERANK_BACKEND=heuristic
DIALECTICA_RERANK_MODEL=Xenova/bge-reranker-base
DIALECTICA_RERANK_ALPHA=0.5
DIALECTICA_RERANK_Z_FLOOR=-0.5
DIALECTICA_RERANK_MIN_MARGIN=0.15
DIALECTICA_RERANK_TOP_N=8

# ---- 证据门禁 ----
DIALECTICA_SUPPORT_THRESHOLD=0.30
DIALECTICA_MAX_UNANCHORED_RATIO=0.20
DIALECTICA_PRUNE_UNANCHORED=1

# ---- 辩证协议 ----
DIALECTICA_MAX_ROUNDS=3
DIALECTICA_CONVERGENCE_EPS=0.03
DIALECTICA_SELF_CONSISTENCY=1
DIALECTICA_GAP_RETRIEVAL=1

# ---- 记忆 ----
DIALECTICA_MEMORY_ENABLED=1
DIALECTICA_WORKING_SIZE=16
DIALECTICA_DECAY_LAMBDA=0.02
DIALECTICA_CLUSTER_THRESHOLD=0.86
DIALECTICA_MIN_SUPPORT=2

# ---- 服务 ----
DIALECTICA_HOST=127.0.0.1
DIALECTICA_PORT=8000
DIALECTICA_CORS_ORIGINS=*
DIALECTICA_LOG_LEVEL=INFO
